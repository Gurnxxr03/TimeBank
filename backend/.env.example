# Database Configuration (MySQL 8.0 or SQLite)
DATABASE_URL=mysql+pymysql://timebank_user:timebank_pass@localhost:3307/timebank_db

# Security & JWT Configuration
JWT_SECRET_KEY=replace-with-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Set COOKIE_SECURE=true and COOKIE_SAMESITE=none in HTTPS cross-origin production
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# CORS & Frontend URL (comma-separated for multiple origins)
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Google OAuth Configuration
GOOGLE_CLIENT_ID=
