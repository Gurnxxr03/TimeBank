# Database Configuration
DATABASE_URL=mysql+pymysql://timebank_user:timebank_pass@localhost:3306/timebank_db

# Security & JWT Configuration
JWT_SECRET_KEY=change-this-to-a-super-secret-hex-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_SECURE=false

# CORS & Frontend URL
FRONTEND_URL=http://localhost:5173

# Google OAuth Configuration (Google Identity Services)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
